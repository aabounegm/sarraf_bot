# development | production (production disables /api/dev/*)
NODE_ENV=development
BOT_TOKEN=
# Public HTTPS URL of the mini app (Telegram requires HTTPS; use a tunnel in dev)
WEBAPP_URL=https://example.com
# Channel the bot posts offers to: @handle or -100... id. Bot must be admin there.
OFFERS_CHANNEL=@innoexchange
# Comma-separated chat ids whose members may post/take. Empty = everyone.
MEMBER_CHATS=
DATABASE_PATH=./data/sarraf.db
PORT=3000
