# development | production (production disables /api/dev/*)
NODE_ENV=development
BOT_TOKEN=
# Public HTTPS origin of this bot. Serves the mini app at /, the API at /api and, in webhook mode, /webhook.
# Dev: a tunnel to Vite (e.g. https://dev-innoexchange.bots.abounegm.com). Prod: https://innoexchange.bots.abounegm.com
PUBLIC_URL=https://example.com
# polling (dev) | webhook (prod: registers PUBLIC_URL/webhook with Telegram on boot)
BOT_MODE=polling
# Channel the bot posts offers to: @handle or -100... id. Bot must be admin there.
OFFERS_CHANNEL=@innoexchange
# Comma-separated chat ids whose members may post/take. Empty = everyone.
MEMBER_CHATS=
DATABASE_PATH=./data/sarraf.db
PORT=3000
